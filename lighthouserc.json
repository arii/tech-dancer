{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm run preview",
      "startServerReadyPattern": "localhost:",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/blog/index.html",
        "http://localhost:4173/merch/index.html",
        "http://localhost:4173/gear/index.html",
        "http://localhost:4173/research/index.html"
      ],
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu --disable-software-rasterizer"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.25 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 12000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.2 }],
        "total-blocking-time": ["error", { "maxNumericValue": 1500 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
