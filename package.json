{
  "name": "tech-dancer",
  "private": true,
  "version": "0.8.0",
  "dependencyComments": {
    "openai": "Required exclusively by boomtick-pkg scripts (e.g. impact-ai-code-review.ts) running in the parent repository context during CI. It is not loaded by any application components or included in the frontend bundle."
  },
  "type": "module",
  "scripts": {
    "release:patch": "pnpm version patch",
    "release:minor": "pnpm version minor",
    "release:major": "pnpm version major",
    "setup:playwright": "playwright install --with-deps chromium",
    "dev": "shx mkdir -p public/data && shx cp etl/data/wcs_prelims.parquet public/data/wcs_prelims.parquet && vite --port=3000 --host=0.0.0.0",
    "prebuild": "tsx scripts/generate-assets.ts",
    "build": "shx mkdir -p public/data && shx cp etl/data/wcs_prelims.parquet public/data/wcs_prelims.parquet && pnpm run type-check && vite build",
    "build:review": "DISABLE_MINIFY=true pnpm run build",
    "postbuild": "tsx scripts/generate-robots.ts && tsx scripts/generate-spa-stubs.mjs && node scripts/clean-sitemap.mjs && tsx scripts/generate-merchant-feed.ts",
    "build:analyze": "ANALYZE=true vite build",
    "build:profile": "vite build --profile",
    "prepreview": "node scripts/cleanup-ports.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "agent:prime": "node scripts/agent-prime.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert 'visual comparison|Jack & Jill O.Rama'",
    "test:e2e:targeted": "playwright test",
    "lighthouse": "lhci autorun",
    "clean": "rm -rf dist",
    "lint": "run-p lint:*",
    "lint:ox": "oxlint --deny-warnings src/ tests/ scripts/",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:types": "tsc --noEmit",
    "lint:python": "pylint etl/ scripts/ tests/",
    "type-check:python": "mypy .",
    "audit:semgrep": "semgrep scan --config auto --error",
    "audit:anti-patterns": "PYTHONPATH=boomtick-pkg/cli:boomtick-pkg/cli/dev_tools node boomtick-pkg/scripts/detect-antipatterns.mjs $PWD/src $PWD/.github/workflows $PWD/.npmrc",
    "audit:dead-code": "pnpm exec knip",
    "audit:duplication": "jscpd .",
    "ci:local": "run-s lint type-check test audit:anti-patterns audit:dead-code audit:semgrep audit:duplication",
    "knip": "knip",
    "type-check": "tsc --noEmit",
    "audit:inventory": "node boomtick-pkg/scripts/check-suppression-inventory.mjs",
    "review:ux:prep": "pnpm run setup:playwright && node boomtick-pkg/scripts/detect-antipatterns.mjs",
    "review:ux:desktop": "playwright open http://localhost:3000/ --device=\"Desktop Chrome\"",
    "review:ux:mobile": "playwright open http://localhost:3000/ --device=\"iPhone 12\"",
    "doctor": "td-cli doctor",
    "preinstall": "node -e \"if (process.env.SKIP_BOOMTICK_PKG !== 'true' && process.env.VERCEL !== '1') { try { require('node:child_process').execSync('td-cli doctor', {stdio: 'inherit'}); } catch (e) {} }\"",
    "postinstall": "python3 scripts/sync-python-deps.py",
    "drafter": "tsx scripts/affiliate/add-item.ts",
    "ai:index": "python3 scripts/index-codebase.py",
    "affiliate:add": "tsx scripts/affiliate/add-item.ts",
    "affiliate:image": "tsx scripts/affiliate/image-helper.ts",
    "affiliate:audit": "tsx scripts/affiliate/audit.ts",
    "affiliate:audit:links": "tsx scripts/affiliate/audit-links.ts",
    "audit:semantic": "node boomtick-pkg/scripts/detect-semantic-duplicates.mjs",
    "impact:analysis": "tsx boomtick-pkg/scripts/impact-analysis.ts",
    "impact:build-main": "tsx boomtick-pkg/scripts/impact-build-main.ts",
    "impact:visual-diff": "tsx boomtick-pkg/scripts/impact-visual-diff.ts",
    "impact:dom-diff": "NODE_OPTIONS=--max-old-space-size=8192 tsx boomtick-pkg/scripts/impact-dom-diff.ts",
    "impact:gemini-review": "tsx boomtick-pkg/scripts/impact-ai-review.ts gemini",
    "impact:github-models-review": "tsx boomtick-pkg/scripts/impact-ai-review.ts github-models",
    "impact:gemini-code-review": "tsx boomtick-pkg/scripts/impact-ai-code-review.ts gemini",
    "impact:github-models-code-review": "tsx boomtick-pkg/scripts/impact-ai-code-review.ts github-models"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@langchain/core": "^1.2.2",
    "@langchain/google-genai": "^2.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.12.1",
    "fuse.js": "^7.3.0",
    "glob": "^13.0.6",
    "hyparquet": "^1.25.6",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "5.5.3",
    "path-to-regexp": "^8.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "2.15.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vercel/node": "^5.8.23",
    "dependency-cruiser": "^17.4.3",
    "diff": "^9.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jscpd": "^5.0.11",
    "jsdom": "^29.1.1",
    "knip": "^6.7.0",
    "mdast": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "openai": "^6.48.0",
    "oxlint": "^1.61.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.61.1",
    "pngjs": "^7.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.0",
    "shx": "^0.4.0",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.4.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.28.2",
  "knip": {
    "ignoreDependencies": [
      "@langchain/core",
      "@langchain/google-genai"
    ],
    "exclude": [
      "exports",
      "types",
      "nsTypes"
    ]
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4",
      "vite": "^6.4.3",
      "hono": "^4.12.29",
      "@babel/plugin-transform-modules-systemjs": "^7.29.7",
      "uuid": "^14.0.1",
      "protobufjs": "7.6.5",
      "fast-uri": "3.1.3",
      "@grpc/grpc-js": "1.14.4",
      "ws": "8.21.0",
      "lighthouse>ws": "7.5.11",
      "dompurify": "3.4.12",
      "esbuild": "^0.28.1",
      "qs": "^6.15.3",
      "js-yaml": "^4.3.0",
      "tmp": "^0.2.7",
      "serialize-javascript": "^7.0.5",
      "brace-expansion": "^5.0.7",
      "@babel/core": "^7.29.6",
      "undici@^5": "^6.27.0",
      "undici@^6": "^6.27.0",
      "websocket-driver": ">=0.7.5",
      "smol-toml": "^1.6.1",
      "body-parser": "^1.20.6",
      "minimatch": "^10.2.5",
      "eslint>ajv": "^6.14.0",
      "ajv@^8": "^8.18.0"
    }
  }
}
