{
  "name": "react-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "release:patch": "pnpm version patch",
    "release:minor": "pnpm version minor",
    "release:major": "pnpm version major",
    "setup:playwright": "playwright install --with-deps chromium",
    "dev": "shx mkdir -p public/data && shx cp etl/data/wcs_prelims.parquet public/data/wcs_prelims.parquet && vite --port=3000 --host=0.0.0.0",
    "prebuild": "tsx scripts/generate-assets.ts",
    "build": "shx mkdir -p public/data && shx cp etl/data/wcs_prelims.parquet public/data/wcs_prelims.parquet && pnpm run type-check && vite build",
    "postbuild": "tsx scripts/generate-robots.ts && tsx scripts/generate-spa-stubs.mjs && node scripts/clean-sitemap.mjs",
    "build:analyze": "ANALYZE=true vite build",
    "build:profile": "vite build --profile",
    "prepreview": "node scripts/cleanup-ports.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert 'visual comparison|Jack & Jill O.Rama'",
    "lighthouse": "lhci autorun",
    "clean": "rm -rf dist",
    "lint": "run-p lint:*",
    "lint:ox": "oxlint --deny-warnings src/ tests/ scripts/",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:types": "tsc --noEmit",
    "knip": "knip --exclude exports",
    "type-check": "tsc --noEmit",
    "audit": "node scripts/detect-antipatterns.mjs",
    "audit:inventory": "node scripts/check-suppression-inventory.mjs",
    "review:ux:prep": "pnpm run setup:playwright && pnpm run audit",
    "review:ux:desktop": "playwright open http://localhost:3000/ --device=\"Desktop Chrome\"",
    "review:ux:mobile": "playwright open http://localhost:3000/ --device=\"iPhone 12\"",
    "repair-context": "PYTHONPATH=$PYTHONPATH:dev-tools python3 dev-tools/td_cli.py repair-context",
    "doctor": "node scripts/check-runtime.mjs",
    "check:runtime-files": "node scripts/check-runtime-files.mjs",
    "preinstall": "node scripts/check-runtime.mjs",
    "drafter": "tsx scripts/affiliate/add-item.ts",
    "affiliate:add": "tsx scripts/affiliate/add-item.ts",
    "affiliate:image": "tsx scripts/affiliate/image-helper.ts",
    "affiliate:audit": "tsx scripts/affiliate/audit.ts",
    "audit:semantic": "node scripts/detect-semantic-duplicates.mjs",
    "impact:analysis": "tsx scripts/impact-analysis.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.12.1",
    "fuse.js": "^7.3.0",
    "glob": "^13.0.6",
    "hyparquet": "^1.25.6",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "5.5.3",
    "path-to-regexp": "^8.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "3.0.0",
    "react-hook-form": "^7.73.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "2.15.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.12"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "10.28.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.49.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "knip": "^6.7.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.61.0",
    "playwright": "1.49.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "shx": "^0.4.0",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.4.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.28.2"
}
