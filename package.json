{
  "name": "react-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "release:patch": "pnpm version patch",
    "release:minor": "pnpm version minor",
    "release:major": "pnpm version major",
    "setup:playwright": "playwright install --with-deps chromium",
    "dev": "shx mkdir -p public/data && shx cp etl/data/wcs_prelims.parquet public/data/wcs_prelims.parquet && vite --port=3000 --host=0.0.0.0",
    "prebuild": "pnpm run verify:schemas && tsx scripts/generate-assets.ts",
    "build": "shx mkdir -p public/data && shx cp etl/data/wcs_prelims.parquet public/data/wcs_prelims.parquet && pnpm run type-check && vite build",
    "build:review": "DISABLE_MINIFY=true pnpm run build",
    "postbuild": "tsx scripts/generate-robots.ts && tsx scripts/generate-spa-stubs.mjs && node scripts/clean-sitemap.mjs && pnpm run agent:prime",
    "build:analyze": "ANALYZE=true vite build",
    "build:profile": "vite build --profile",
    "prepreview": "node scripts/cleanup-ports.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert 'visual comparison|Jack & Jill O.Rama'",
    "test:e2e:targeted": "playwright test",
    "lighthouse": "lhci autorun",
    "clean": "rm -rf dist",
    "lint": "run-p lint:*",
    "lint:ox": "oxlint --deny-warnings src/ tests/ scripts/",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:types": "tsc --noEmit",
    "lint:python": "pylint etl/ boomtick-pkg/ scripts/ tests/",
    "type-check:python": "mypy .",
    "audit:semgrep": "semgrep scan --config auto --error",
    "audit:anti-patterns": "PYTHONPATH=boomtick-pkg/cli:boomtick-pkg/cli/dev_tools node boomtick-pkg/scripts/detect-antipatterns.mjs",
    "audit:dead-code": "pnpm exec knip",
    "audit:duplication": "jscpd .",
    "audit:duplication:pkg": "jscpd boomtick-pkg/ --config boomtick-pkg/.jscpd.json",
    "ci:local": "run-s verify:schemas lint type-check test audit:anti-patterns audit:dead-code audit:semgrep audit:duplication audit:duplication:pkg",
    "knip": "knip",
    "type-check": "pnpm run verify:schemas && tsc --noEmit",
    "audit:inventory": "node boomtick-pkg/scripts/check-suppression-inventory.mjs",
    "verify:schemas": "node scripts/verify-schemas.mjs",
    "review:ux:prep": "pnpm run setup:playwright && node boomtick-pkg/scripts/detect-antipatterns.mjs",
    "review:ux:desktop": "playwright open http://localhost:3000/ --device=\"Desktop Chrome\"",
    "review:ux:mobile": "playwright open http://localhost:3000/ --device=\"iPhone 12\"",
    "repair-context": "PYTHONPATH=$PYTHONPATH:boomtick-pkg/cli td-cli repair-context",
    "doctor": "node boomtick-pkg/scripts/check-runtime.mjs",
    "check:runtime-files": "node boomtick-pkg/scripts/check-runtime-files.mjs",
    "preinstall": "node boomtick-pkg/scripts/check-runtime.mjs",
    "postinstall": "python3 scripts/sync-python-deps.py",
    "drafter": "tsx scripts/affiliate/add-item.ts",
    "ai:index": "python3 scripts/index-codebase.py",
    "affiliate:add": "tsx scripts/affiliate/add-item.ts",
    "affiliate:image": "tsx scripts/affiliate/image-helper.ts",
    "affiliate:audit": "tsx scripts/affiliate/audit.ts",
    "affiliate:audit:links": "tsx scripts/affiliate/audit-links.ts",
    "audit:semantic": "node boomtick-pkg/scripts/detect-semantic-duplicates.mjs",
    "impact:analysis": "tsx boomtick-pkg/scripts/impact-analysis.ts",
    "impact:build-main": "tsx boomtick-pkg/scripts/impact-build-main.ts",
    "impact:visual-diff": "tsx boomtick-pkg/scripts/impact-visual-diff.ts",
    "impact:dom-diff": "tsx boomtick-pkg/scripts/impact-dom-diff.ts",
    "impact:gemini-review": "tsx boomtick-pkg/scripts/impact-gemini-review.ts",
    "impact:github-models-review": "tsx boomtick-pkg/scripts/impact-github-models-review.ts",
    "impact:gemini-code-review": "tsx boomtick-pkg/scripts/impact-gemini-code-review.ts",
    "impact:github-models-code-review": "tsx boomtick-pkg/scripts/impact-github-models-code-review.ts",
    "agent:prime": "command -v td-cli > /dev/null 2>&1 && td-cli context-warm || true"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@langchain/core": "^1.2.2",
    "@langchain/google-genai": "^2.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.12.1",
    "fuse.js": "^7.3.0",
    "glob": "^13.0.6",
    "hyparquet": "^1.25.6",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "5.5.3",
    "path-to-regexp": "^8.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "2.15.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vercel/node": "^5.8.23",
    "dependency-cruiser": "^17.4.3",
    "diff": "^9.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jscpd": "^5.0.11",
    "jsdom": "^29.1.1",
    "knip": "^6.7.0",
    "mdast": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.61.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.60.0",
    "pngjs": "^7.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "shx": "^0.4.0",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.4.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4"
    }
  },
  "packageManager": "pnpm@10.28.2",
  "knip": {
    "ignoreDependencies": [
      "@langchain/core",
      "@langchain/google-genai"
    ],
    "exclude": [
      "exports",
      "types",
      "nsTypes"
    ]
  }
}
