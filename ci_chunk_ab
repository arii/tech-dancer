    name: Anti-Pattern Audit
    needs: verify-changes
    if: needs.verify-changes.outputs.has_changes == 'true'
    timeout-minutes: 10
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/arii/tech-dancer:latest
    steps:
      - name: Configure Git Safe Directory
        run: git config --global --add safe.directory "$GITHUB_WORKSPACE"

      # Setup dependencies once and use caching for speedup.
      - uses: actions/checkout@v7

      - name: Setup Node and pnpm
        uses: ./.github/actions/setup-node-pnpm

      - name: Setup Workspace
        uses: ./.github/actions/setup-workspace

      - name: Install dependencies
        shell: bash
        run: |
          echo "::group::pnpm install"
          trap 'echo "::endgroup::"' EXIT
          pnpm install --frozen-lockfile --prefer-offline

      - parallel:
          - name: UI Anti-Pattern Audit - Gate
            shell: bash
            env:
              GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
            run: |
              echo "::group::Audit"
              trap 'echo "::endgroup::"' EXIT
              # Ensure local python bin is on path for td
              export PATH="$HOME/.local/bin:/github/home/.local/bin:$PATH"
              if ! node scripts/detect-antipatterns.mjs; then echo "Audit failed"; exit 1; fi
              td gh audit-gate

          - name: Design Token Compliance
            run: |
              # Dynamic search for TSX files to avoid hardcoded paths.
              VIOLATIONS=$(find . -name "*.tsx" -not -path "*/node_modules/*" -type f | xargs grep -h '#[0-9a-fA-F]\{3,6\}' \
                | grep -vc "design-tokens\|tokens.css\|// impeccable-ignore" || echo 0)
              if [ "$VIOLATIONS" -gt 0 ]; then
                echo "⚠️ Found $VIOLATIONS raw hex color(s) in tsx files. Use CSS variables instead."
                find . -name "*.tsx" -not -path "*/node_modules/*" -type f | xargs grep -rn '#[0-9a-fA-F]\{3,6\}' | grep -v "design-tokens\|tokens.css"
                exit 1
              fi
              echo "✅ Design token compliance passed."

  test-build:
    name: Build & E2E
    needs: [verify-changes, lint-typecheck]
    if: needs.verify-changes.outputs.has_changes == 'true'
    timeout-minutes: 15
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/arii/tech-dancer:latest
    env:
      NODE_ENV: production
      REPO_NAME: ${{ github.event.repository.name }}
      PLAYWRIGHT_BROWSERS_PATH: /ms-playwright
      PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: 1
    steps:
      - name: Configure Git Safe Directory
        run: git config --global --add safe.directory "$GITHUB_WORKSPACE"

      # Setup dependencies once and use caching for speedup.
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Setup Node and pnpm
        uses: ./.github/actions/setup-node-pnpm

      - name: Setup Workspace
        uses: ./.github/actions/setup-workspace

      - run: pnpm install --frozen-lockfile --prefer-offline

      - name: Build App
        run: |
          # Build with root base path for Playwright preview tests.
          # Playwright runs with VITE_BASE_PATH=/, so dist must use root-relative assets.
          VITE_BASE_PATH=/; export VITE_BASE_PATH
          pnpm run build


      - name: Bundle Size Check
        id: bundle-size
        background: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # Ensure local python bin is on path for td
          export PATH="$HOME/.local/bin:/github/home/.local/bin:$PATH"
          td gh bundle-size
