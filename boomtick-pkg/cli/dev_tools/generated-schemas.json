{
  "github.search_open_prs": {
    "properties": {
      "state": {
        "default": "open",
        "description": "The state of the PRs to search for (open, closed, all).",
        "enum": [
          "open",
          "closed",
          "all"
        ],
        "type": "string"
      },
      "includeDrafts": {
        "default": true,
        "description": "Whether to include draft PRs in the results.",
        "type": "boolean"
      },
      "limit": {
        "default": 100,
        "description": "The maximum number of PRs to return (default: 100, range: 1-100).",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "labels": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Filter PRs by labels."
      }
    },
    "title": "SearchPrsRequest",
    "type": "object"
  },
  "github.create_issue": {
    "properties": {
      "title": {
        "description": "The title of the issue.",
        "type": "string"
      },
      "body": {
        "description": "The body/description of the issue.",
        "type": "string"
      }
    },
    "required": [
      "title",
      "body"
    ],
    "title": "CreateIssueRequest",
    "type": "object"
  },
  "github.get_pr_diff": {
    "properties": {
      "prNumber": {
        "description": "The number of the pull request to get the diff for.",
        "type": "number"
      }
    },
    "required": [
      "prNumber"
    ],
    "title": "GetPrDiffRequest",
    "type": "object"
  },
  "repo.read_ci_logs": {
    "properties": {
      "prNumber": {
        "type": "number"
      },
      "all": {
        "default": false,
        "description": "Include logs for successful runs (default: false).",
        "type": "boolean"
      }
    },
    "required": [
      "prNumber"
    ],
    "title": "ReadCiLogsRequest",
    "type": "object"
  },
  "jules.create_session": {
    "properties": {
      "task": {
        "description": "The instructions for Jules.",
        "type": "string"
      },
      "branch": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The base branch to start from (e.g., 'main')."
      },
      "pr": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The PR number to use as the base branch context."
      }
    },
    "required": [
      "task"
    ],
    "title": "CreateJulesSessionRequest",
    "type": "object"
  },
  "github.checkout_branch": {
    "properties": {
      "branch": {
        "description": "The name of the branch to checkout.",
        "type": "string"
      },
      "worktreePath": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional path to the worktree to perform the checkout in."
      }
    },
    "required": [
      "branch"
    ],
    "title": "CheckoutBranchRequest",
    "type": "object"
  },
  "github.get_merge_conflict_files": {
    "properties": {
      "prNumber": {
        "description": "The number of the pull request to check for conflicts.",
        "type": "number"
      },
      "baseBranch": {
        "default": "main",
        "description": "The base branch to check against (default: 'main').",
        "type": "string"
      }
    },
    "required": [
      "prNumber"
    ],
    "title": "GetMergeConflictFilesRequest",
    "type": "object"
  },
  "repo.run_tests": {
    "properties": {
      "commands": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional list of commands to run (default includes install, lint, test, build)."
      },
      "timeoutSeconds": {
        "default": 300,
        "description": "Maximum time in seconds to wait for tests (default: 300).",
        "type": "number"
      },
      "worktreePath": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional path to the worktree to run tests in."
      }
    },
    "title": "RunTestsRequest",
    "type": "object"
  },
  "github.create_pull_request": {
    "properties": {
      "title": {
        "description": "PR Title.",
        "type": "string"
      },
      "body": {
        "description": "Description of changes.",
        "type": "string"
      },
      "head": {
        "description": "The branch containing changes to merge.",
        "type": "string"
      },
      "base": {
        "default": "main",
        "description": "The target branch to merge into.",
        "type": "string"
      },
      "draft": {
        "default": false,
        "description": "Whether to create the PR as a draft.",
        "type": "boolean"
      }
    },
    "required": [
      "title",
      "body",
      "head"
    ],
    "title": "CreatePullRequestRequest",
    "type": "object"
  },
  "github.issue_view": {
    "properties": {
      "issueNumber": {
        "description": "The number of the issue to view.",
        "type": "number"
      }
    },
    "required": [
      "issueNumber"
    ],
    "title": "IssueViewRequest",
    "type": "object"
  },
  "github.issue_update": {
    "properties": {
      "issueNumber": {
        "description": "The number of the issue to update.",
        "type": "number"
      },
      "body": {
        "description": "The new body content for the issue.",
        "type": "string"
      }
    },
    "required": [
      "issueNumber",
      "body"
    ],
    "title": "IssueUpdateRequest",
    "type": "object"
  },
  "github.issue_comment": {
    "properties": {
      "issueNumber": {
        "description": "The number of the issue to comment on.",
        "type": "number"
      },
      "body": {
        "description": "The content of the comment.",
        "type": "string"
      }
    },
    "required": [
      "issueNumber",
      "body"
    ],
    "title": "IssueCommentRequest",
    "type": "object"
  }
}