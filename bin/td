#!/usr/bin/env bash
# BoomTick CLI Wrapper
# Automatically configures PYTHONPATH and invokes the dev_tools.cli

set -e

# Find repository root
# Try git first, then look for markers like pnpm-workspace.yaml
if git rev-parse --show-toplevel >/dev/null 2>&1; then
    REPO_ROOT="$(git rev-parse --show-toplevel)"
else
    # Fallback: search upwards for package.json or pnpm-workspace.yaml
    CUR_DIR="$(pwd -P)"
    while [ "$CUR_DIR" != "/" ]; do
        if [ -f "$CUR_DIR/pnpm-workspace.yaml" ] || [ -f "$CUR_DIR/package.json" ]; then
            REPO_ROOT="$CUR_DIR"
            break
        fi
        CUR_DIR="$(dirname "$CUR_DIR")"
    done
fi

if [ -z "$REPO_ROOT" ]; then
    echo "❌ Error: Could not resolve REPO_ROOT. Ensure you are inside the repository." >&2
    exit 1
fi

# Resolve CLI root
if [ -d "${REPO_ROOT}/boomtick-pkg/cli" ]; then
    CLI_ROOT="${REPO_ROOT}/boomtick-pkg/cli"
elif [ -d "${REPO_ROOT}/cli" ]; then
    CLI_ROOT="${REPO_ROOT}/cli"
else
    echo "❌ Error: Could not resolve CLI_ROOT at ${REPO_ROOT}/boomtick-pkg/cli or ${REPO_ROOT}/cli" >&2
    exit 1
fi

# Resolve Python executable
# Prefer .venv if it exists at repo root
if [ -x "${REPO_ROOT}/.venv/bin/python3" ]; then
    PYTHON_EXEC="${REPO_ROOT}/.venv/bin/python3"
elif [ -x "${REPO_ROOT}/.venv/bin/python" ]; then
    PYTHON_EXEC="${REPO_ROOT}/.venv/bin/python"
else
    PYTHON_EXEC="python3"
fi

# Export PYTHONPATH to include CLI_ROOT
# We use :$PYTHONPATH to preserve existing paths if any
export PYTHONPATH="${CLI_ROOT}${PYTHONPATH:+:$PYTHONPATH}"

# Execute the CLI
exec "$PYTHON_EXEC" -m dev_tools.cli "$@"
