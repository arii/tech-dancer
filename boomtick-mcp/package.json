{
  "name": "boomtick-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local MCP server for Boomtick PR rescue and merge-conflict workflows.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "verify:tools": "pnpm build && tsx scripts/verify-mcp-tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2"
}
