#!/usr/bin/env bash

# .githooks/post-checkout
# Runs after 'git checkout' or 'git switch'
# $1 = previous HEAD, $2 = new HEAD, $3 = flag (1 = branch checkout, 0 = file checkout)

set -e

if [ "$3" -eq 0 ]; then
    # Skip if it was only a file checkout
    exit 0
fi

prev_head="$1"
new_head="$2"

# If previous HEAD is null (e.g. initial clone or some weird state), use a sensible default or skip
if [ -z "$prev_head" ] || [ "$prev_head" = "0000000000000000000000000000000000000000" ]; then
    exit 0
fi

changed_files="$(git diff --name-only "$prev_head" "$new_head")"

check_run() {
    echo "$changed_files" | grep -qE "$1"
}

echo "⚓ Running post-checkout hooks..."

if check_run "pnpm-lock.yaml|package.json"; then
    echo "📦 Node dependencies changed. Running pnpm install..."
    pnpm install
fi

if check_run "^dev-tools/"; then
    echo "🐍 dev-tools changed. Re-installing in editable mode..."
    if ! python3 -m pip install --root-user-action=ignore -e ./dev-tools; then
        python3 -m pip install --root-user-action=ignore -e ./dev-tools --break-system-packages
    fi
fi

if check_run "^boomtick-mcp/"; then
    echo "🤖 boomtick-mcp changed. Rebuilding..."
    pnpm --filter boomtick-mcp run build
fi
