#!/bin/bash
# .githooks/commit-msg
# Enforce the No-Op Protection Policy

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" | grep -v '^#')

# Convert to lowercase for case-insensitive matching
COMMIT_MSG_LOWER=$(echo "$COMMIT_MSG" | tr '[:upper:]' '[:lower:]')

# Read forbidden phrases from file
PHRASES_FILE="$(dirname "$0")/forbidden-phrases.txt"

if [ -f "$PHRASES_FILE" ]; then
    while IFS= read -r phrase || [ -n "$phrase" ]; do
        # skip empty lines
        [ -z "$phrase" ] && continue
        if [[ "$COMMIT_MSG_LOWER" == *"$phrase"* ]]; then
            echo "❌ Error: Forbidden commit message detected."
            echo "The No-Op Protection Policy prohibits placeholder commits such as '$phrase'."
            exit 1
        fi
    done < "$PHRASES_FILE"
fi

# Check if commit message is essentially empty (only whitespace)
if [ -z "$(echo "$COMMIT_MSG" | tr -d '[:space:]')" ]; then
    echo "❌ Error: Empty commit message."
    exit 1
fi

exit 0
