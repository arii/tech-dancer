#!/usr/bin/env bash

# .githooks/post-merge
# Runs after a successful 'git merge' (or 'git pull')

echo "⚓ Running post-merge hooks..."

# ORIG_HEAD is a git reference set by git to the state before the merge.
changed_files="$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null || echo "")"

bash .githooks/update-env.sh "$changed_files"

exit 0
