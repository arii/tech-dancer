#!/usr/bin/env bash

# .githooks/post-merge
# Runs after a successful 'git merge' (or 'git pull')

set -e

changed_files="$(git diff --name-only ORIG_HEAD HEAD)"

check_run() {
    echo "$changed_files" | grep -qE "$1"
}

echo "⚓ Running post-merge hooks..."

if check_run "pnpm-lock.yaml|package.json"; then
    echo "📦 Node dependencies changed. Running pnpm install..."
    pnpm install
fi

if check_run "^dev-tools/"; then
    echo "🐍 dev-tools changed. Re-installing in editable mode..."
    if ! python3 -m pip install --root-user-action=ignore -e ./dev-tools; then
        python3 -m pip install --root-user-action=ignore -e ./dev-tools --break-system-packages
    fi
fi

if check_run "^boomtick-mcp/"; then
    echo "🤖 boomtick-mcp changed. Rebuilding..."
    pnpm --filter boomtick-mcp run build
fi
