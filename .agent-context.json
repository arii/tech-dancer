{
  "repo": {
    "name": "react-example"
  },
  "package_json": {
    "name": "react-example",
    "scripts": {
      "release:patch": "pnpm version patch",
      "release:minor": "pnpm version minor",
      "release:major": "pnpm version major",
      "setup:playwright": "playwright install --with-deps chromium",
      "dev": "shx mkdir -p public/data && shx cp etl/data/wcs_prelims.parquet public/data/wcs_prelims.parquet && vite --port=3000 --host=0.0.0.0",
      "prebuild": "tsx scripts/generate-assets.ts",
      "build": "shx mkdir -p public/data && shx cp etl/data/wcs_prelims.parquet public/data/wcs_prelims.parquet && pnpm run type-check && vite build",
      "build:review": "DISABLE_MINIFY=true pnpm run build",
      "postbuild": "tsx scripts/generate-robots.ts && tsx scripts/generate-spa-stubs.mjs && node scripts/clean-sitemap.mjs && pnpm run agent:prime",
      "build:analyze": "ANALYZE=true vite build",
      "build:profile": "vite build --profile",
      "prepreview": "node scripts/cleanup-ports.mjs",
      "preview": "vite preview",
      "test": "vitest run",
      "test:watch": "vitest",
      "test:e2e": "playwright test --grep-invert 'visual comparison|Jack & Jill O.Rama'",
      "test:e2e:targeted": "playwright test",
      "lighthouse": "lhci autorun",
      "clean": "rm -rf dist",
      "lint": "run-p lint:*",
      "lint:ox": "oxlint --deny-warnings src/ tests/ scripts/",
      "lint:eslint": "eslint . --max-warnings 0",
      "lint:types": "tsc --noEmit",
      "audit:semgrep": "semgrep scan --config auto --error",
      "audit:anti-patterns": "pnpm run audit",
      "audit:dead-code": "pnpm run knip",
      "ci:local": "run-s lint type-check test audit:anti-patterns audit:dead-code audit:semgrep",
      "knip": "knip --exclude exports",
      "type-check": "tsc --noEmit",
      "audit": "node scripts/detect-antipatterns.mjs",
      "audit:inventory": "node scripts/check-suppression-inventory.mjs",
      "review:ux:prep": "pnpm run setup:playwright && pnpm run audit",
      "review:ux:desktop": "playwright open http://localhost:3000/ --device=\"Desktop Chrome\"",
      "review:ux:mobile": "playwright open http://localhost:3000/ --device=\"iPhone 12\"",
      "repair-context": "PYTHONPATH=$PYTHONPATH:dev-tools python3 dev-tools/td_cli.py repair-context",
      "doctor": "node scripts/check-runtime.mjs",
      "check:runtime-files": "node scripts/check-runtime-files.mjs",
      "preinstall": "node scripts/check-runtime.mjs",
      "drafter": "tsx scripts/affiliate/add-item.ts",
      "affiliate:add": "tsx scripts/affiliate/add-item.ts",
      "affiliate:image": "tsx scripts/affiliate/image-helper.ts",
      "affiliate:audit": "tsx scripts/affiliate/audit.ts",
      "affiliate:audit:links": "tsx scripts/affiliate/audit-links.ts",
      "audit:semantic": "node scripts/detect-semantic-duplicates.mjs",
      "impact:analysis": "tsx scripts/impact-analysis.ts",
      "impact:build-main": "tsx scripts/impact-build-main.ts",
      "impact:visual-diff": "tsx scripts/impact-visual-diff.ts",
      "impact:dom-diff": "tsx scripts/impact-dom-diff.ts",
      "impact:gemini-review": "tsx scripts/impact-gemini-review.ts",
      "impact:github-models-review": "tsx scripts/impact-github-models-review.ts",
      "impact:gemini-code-review": "tsx scripts/impact-gemini-code-review.ts",
      "impact:github-models-code-review": "tsx scripts/impact-github-models-code-review.ts",
      "agent:prime": "python3 scripts/build-repo-context.py > .agent-context.json"
    },
    "dependencies": [
      "@google/genai",
      "@tailwindcss/vite",
      "@tanstack/react-query",
      "@types/react-syntax-highlighter",
      "@vercel/analytics",
      "@vercel/speed-insights",
      "@vitejs/plugin-react",
      "class-variance-authority",
      "clsx",
      "firebase",
      "fuse.js",
      "glob",
      "hyparquet",
      "jspdf",
      "jspdf-autotable",
      "lucide-react",
      "motion",
      "papaparse",
      "path-to-regexp",
      "react",
      "react-dom",
      "react-helmet-async",
      "react-markdown",
      "react-router-dom",
      "react-syntax-highlighter",
      "recharts",
      "rehype-raw",
      "rehype-sanitize",
      "remark-gfm",
      "remark-parse",
      "tailwind-merge",
      "tw-animate-css",
      "unified",
      "unist-util-visit",
      "vite-plugin-pwa",
      "workbox-window",
      "yaml"
    ],
    "devDependencies": [
      "@axe-core/playwright",
      "@eslint/js",
      "@langchain/core",
      "@langchain/google-genai",
      "@langchain/openai",
      "@lhci/cli",
      "@playwright/test",
      "@tailwindcss/typography",
      "@testing-library/dom",
      "@testing-library/react",
      "@types/jsdom",
      "@types/mdast",
      "@types/node",
      "@types/papaparse",
      "@types/pixelmatch",
      "@types/pngjs",
      "dependency-cruiser",
      "diff",
      "eslint",
      "eslint-plugin-react-hooks",
      "globals",
      "jsdom",
      "knip",
      "mdast",
      "npm-run-all",
      "oxlint",
      "pixelmatch",
      "playwright",
      "pngjs",
      "rollup-plugin-visualizer",
      "sharp",
      "shx",
      "svgo",
      "tailwindcss",
      "tsx",
      "typescript",
      "typescript-eslint",
      "vite",
      "vite-plugin-image-optimizer",
      "vite-plugin-inspect",
      "vite-plugin-sitemap",
      "vitest"
    ]
  },
  "workflows": [
    ".github/workflows/workflow-validation.yml",
    ".github/workflows/mass-audit-prs.yml",
    ".github/workflows/codeql.yml",
    ".github/workflows/self-healing.yml",
    ".github/workflows/auto-conflict-resolver.yml",
    ".github/workflows/issue_to_pr.yml",
    ".github/workflows/issue-comment-dispatcher.yml",
    ".github/workflows/mergellama.yml",
    ".github/workflows/ai-chatops.yml",
    ".github/workflows/update-snapshots.yml",
    ".github/workflows/reusable-gate.yml",
    ".github/workflows/ci.yml",
    ".github/workflows/jules-fix-trigger.yml",
    ".github/workflows/wcs_etl.yml",
    ".github/workflows/deploy-image.yml",
    ".github/workflows/deploy.yml",
    ".github/workflows/prune-stale-previews.yml",
    ".github/workflows/validate_issue.yml"
  ],
  "test_snapshots": [],
  "recent_commits": [
    "ebbd2b8f fix: enforce gemini thinking tokens budget and verify complete responses (#2824)"
  ],
  "changed_files": [
    ".agent-context.json",
    ".agent/AGENT_CONTRACT.md",
    ".agent/INSTRUCTION_LAYERS.md",
    "AGENTS.md",
    "boomtick-mcp/src/agents/repo-context.prompt.md",
    "dev-tools/cli-schema.json",
    "package.json"
  ]
}
