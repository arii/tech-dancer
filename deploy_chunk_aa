name: Deploy to GitHub Pages

on:
  push:
    branches:
      - '**'
  workflow_dispatch:


permissions:
  contents: write
  pages: write
  id-token: write
  pull-requests: write
  issues: write

jobs:
  verify-changes:
    uses: ./.github/workflows/reusable-gate.yml
    permissions:
      pull-requests: write
      contents: write

  build:
    needs: verify-changes
    if: needs.verify-changes.outputs.has_changes == 'true'
    runs-on: ubuntu-latest
    concurrency:
      # Build jobs for the same branch can be cancelled if a newer push arrives
      # to save CI minutes, as only the latest build for a branch is relevant.
      group: build-${{ github.ref }}
      cancel-in-progress: true
    steps:
      - name: Checkout Branch
        uses: actions/checkout@v7
        with:
          fetch-depth: 0
          lfs: true

      - name: Setup Node and pnpm
        uses: ./.github/actions/setup-node-pnpm

      - name: Check active runtime
        run: |
          pnpm run check:runtime-files
          pnpm run doctor

      - name: Install Dependencies
        run: pnpm install --frozen-lockfile

      - name: Build Site
        env:
          REPO_NAME: ${{ github.event.repository.name }}
          OWNER: ${{ github.repository_owner }}
          REF_NAME: ${{ github.ref_name }}
        run: |
          # 1. Determine Base Path
          if [ "$REF_NAME" = "main" ]; then
            VITE_BASE_PATH=/$REPO_NAME/; export VITE_BASE_PATH
            VITE_APP_URL="https://$OWNER.github.io/$REPO_NAME/"; export VITE_APP_URL
          else
            VITE_BASE_PATH=/$REPO_NAME/$REF_NAME/; export VITE_BASE_PATH
            VITE_APP_URL="https://$OWNER.github.io/$REPO_NAME/$REF_NAME/"; export VITE_APP_URL
          fi

          # 2. Build the Application
          pnpm run build

          # 3. SEO Aggregation (Only on Main)
          if [ "$REF_NAME" = "main" ]; then
            # Generate robots.txt pointing at canonical sitemap location
            {
              echo "User-agent: *"
              echo "Allow: /$REPO_NAME/"
              echo "Disallow: /$REPO_NAME/previews/"
              echo "Disallow: /$REPO_NAME/404.html"
              echo "Sitemap: https://$OWNER.github.io/$REPO_NAME/sitemap.xml"
            } > dist/robots.txt

            echo "SEO assets generated successfully."
          fi

          # 4. Generate metadata for deployment tracking
          git log -1 --format=%ct > dist/.commit-timestamp
          date +%s > dist/.deploy-timestamp
          echo "${GITHUB_SHA}" > dist/.commit-sha

          # Create verification marker
          jq -n --arg b "$REF_NAME" --arg s "$GITHUB_SHA" --argjson t "$(date +%s)" '{"branch":$b,"sha":$s,"deployedAt":$t}' > dist/.deploy.json

      - name: Upload dist artifact
        uses: actions/upload-artifact@v7
        with:
          name: dist-assets
          path: dist/
          retention-days: 1

  deploy:
    needs: build
    runs-on: ubuntu-latest
