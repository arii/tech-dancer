# The URL where this applet is hosted
VITE_APP_URL="https://boomtick.blog"

# Live WCS Navigator API Server (e.g. Google Cloud Run or local FastAPI)
VITE_WCS_API_URL="https://wcs-navigator-api-237690545533.us-west1.run.app"

# Google Apps Script: Mailing List & Services Intake Form
VITE_MAILING_LIST_DEPLOYMENT_ID=""

# Calendar Booking URL for /services Consultation Scheduling (e.g. Cal.com, Calendly)
VITE_CALENDAR_BOOKING_URL=""

# IndexNow Search Engine Verification Key & Instant Indexing
INDEXNOW_KEY=""
VITE_INDEXNOW_KEY=""

# Google AdSense publisher client (site verification + ad loader).
# Unset or empty = no ad script, no ad markup, unchanged builds.
# The loader waits for the CookieYes banner; ads are personalized only when the
# visitor accepts the Advertisement category.
VITE_ADSENSE_CLIENT="ca-pub-2398582836159289"
# 10-digit ad unit IDs (AdSense > Ads > By ad unit > Display ads > data-ad-slot).
# A placement with no valid ID renders no ad unit.
VITE_ADSENSE_SLOT_IN_ARTICLE=""
VITE_ADSENSE_SLOT_SIDEBAR=""
VITE_ADSENSE_SLOT_LISTING=""

# Vercel Log Drains (Automation)
# Required for scripts/configure-log-drains.mjs
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
LOG_DRAIN_URL="https://api.axiom.co/v1/datasets/boomtick-logs/ingest"
LOG_DRAIN_TOKEN=""
