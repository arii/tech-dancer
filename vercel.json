{
  "installCommand": "corepack enable && corepack prepare pnpm@10.28.2 --activate && SKIP_BOOMTICK_PKG=true pnpm install --frozen-lockfile",
  "buildCommand": "SKIP_BOOMTICK_PKG=true pnpm build",
  "framework": "vite",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.boomtick.blog"
        }
      ],
      "destination": "https://boomtick.blog/$1",
      "statusCode": 301
    },
    {
      "source": "/consulting",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/phd",
      "destination": "https://arii.github.io/research/conformant-planning-manipulation/",
      "permanent": true
    },
    {
      "source": "/home-2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hello-world",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ai-council",
      "destination": "/research",
      "permanent": true
    },
    {
      "source": "/ai",
      "destination": "/research",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/research",
      "permanent": true
    },
    {
      "source": "/tag/ai",
      "destination": "/research",
      "permanent": true
    },
    {
      "source": "/tag/ai/page/:page",
      "destination": "/research",
      "permanent": true
    }
  ]
}
