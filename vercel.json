{
  "installCommand": "corepack enable && corepack prepare pnpm@10.28.2 --activate && SKIP_BOOMTICK_PKG=true pnpm install --frozen-lockfile",
  "buildCommand": "SKIP_BOOMTICK_PKG=true pnpm build",
  "framework": "vite",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.boomtick.blog"
        }
      ],
      "destination": "https://boomtick.blog/$1",
      "statusCode": 301
    },
    {
      "source": "/wcs-navigator",
      "destination": "https://arii.github.io/",
      "statusCode": 308
    },
    {
      "source": "/research/wcs-navigator",
      "destination": "https://arii.github.io/",
      "statusCode": 308
    },
    {
      "source": "/research/2026-07-10-latest-version-check-skill",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/research/ai-devops-pipeline",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/research/confidently-incorrect-v4",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/research/deployment-impact-analyzer",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/research/wcs-navigator-architecture",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/research/wcs-scraper-initial-sync",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/research",
      "destination": "https://arii.github.io/",
      "statusCode": 308
    },
    {
      "source": "/research/:path*",
      "destination": "https://arii.github.io/",
      "statusCode": 308
    }
  ]
}
