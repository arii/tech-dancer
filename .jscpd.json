{
  "threshold": 5,
  "minLines": 6,
  "minTokens": 40,
  "ignore": [
    "src/layouts/**",
    "src/components/ui/**",
    "src/components/editorial/**",
    "src/components/navigation/**",
    "src/providers/**",
    "scripts/**",
    "dev-tools/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "report/**",
    "artifacts/**",
    "**/pnpm-lock.yaml",
    "public/assets/**",
    "public/**/*.svg",
    ".agents/**",
    "plan.md",
    "**/contract.ts",
    "**/*.json"
    "boomtick-pkg/mcp/src/tools/contract.ts",
    "boomtick-pkg/cli/dev_tools/cli-schema.json",
    "boomtick-pkg/mcp/.mcp/schemas/**",
    "boomtick-pkg/cli/setup-agent.sh"
  ],
  "reporters": ["console"]
}
