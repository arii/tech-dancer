{
  "threshold": 5,
  "minLines": 10,
  "minTokens": 75,
  "ignore": [
    "src/layouts/**",
    "src/components/ui/**",
    "src/components/editorial/**",
    "src/components/navigation/**",
    "src/providers/**",
    "scripts/**",
    "dev-tools/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "report/**",
    "artifacts/**",
    "**/pnpm-lock.yaml",
    "public/assets/**",
    ".agents/**"
  ],
  "reporters": ["console"]
}
