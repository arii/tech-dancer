      - name: Run Playwright Smoke Test
        run: |
          VITE_BASE_PATH=/ pnpm run test:e2e

      - name: Run Lighthouse CI
        run: |
          set -eu
          VITE_BASE_PATH="/"
          CHROME_PATH="$(node -e "console.log(require('playwright').chromium.executablePath())")"
          export VITE_BASE_PATH
          export CHROME_PATH
          echo "CHROME_PATH=$CHROME_PATH"
          pnpm run lighthouse --collect.url="http://localhost:4173${VITE_BASE_PATH}"
        env:
          LHCI_GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Check Playwright Report Exists
        id: check_report
        if: always()
        run: |
          if [ -d "playwright-report/" ]; then
            echo "exists=true" >> "$GITHUB_OUTPUT"
          else
            echo "exists=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Upload Test Results
        if: always() && steps.check_report.outputs.exists == 'true'
        uses: actions/upload-artifact@v7
        with:
          name: playwright-report-${{ github.run_id }}
          path: playwright-report/
          retention-days: 7
          if-no-files-found: ignore

      - name: Wait for Bundle Size Check
        wait: bundle-size

      - name: Verify Bundle Size Check
        if: always()
        run: |
          if [ "${{ steps.bundle-size.outcome }}" = "failure" ]; then
            echo "Bundle Size Check failed in background"
            exit 1
          fi

  impact-analysis:
    needs: [verify-changes, lint-typecheck, audit, test-build]
    name: Deployment Impact Analysis
    if: needs.verify-changes.outputs.has_changes == 'true'
    timeout-minutes: 10
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/arii/tech-dancer:latest
    env:
      DISABLE_MINIFY: true
      MAX_AI_REVIEWS: ${{ vars.MAX_AI_REVIEWS }}
      GITHUB_REPOSITORY: ${{ github.repository }}
      PR_NUMBER: ${{ github.event.pull_request.number }}
      GITHUB_MODELS_MODEL: gpt-4o-mini
    steps:
      - name: Configure Git Safe Directory
        run: git config --global --add safe.directory "$GITHUB_WORKSPACE"

      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Setup Node and pnpm
        uses: ./.github/actions/setup-node-pnpm

      - name: Setup Workspace
        uses: ./.github/actions/setup-workspace

      - run: pnpm install --frozen-lockfile --prefer-offline

      - parallel:
          - name: Deployment Impact Analysis
            run: pnpm run impact:analysis
          - name: Build Main
            env:
              DISABLE_MINIFY: true
            run: pnpm run impact:build-main
          - name: Build PR
            env:
              VITE_BASE_PATH: /
              DISABLE_MINIFY: true
            run: pnpm run build:review

      - name: Code review agent
        if: always() && github.event_name == 'pull_request'
        continue-on-error: true
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: pnpm run impact:gemini-code-review

      - name: Code review github models agent
        if: always() && github.event_name == 'pull_request'
        continue-on-error: true
